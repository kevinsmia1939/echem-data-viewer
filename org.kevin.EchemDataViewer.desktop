[Desktop Entry]
Type=Application
Name=Electrochemistry Data Viewer
Comment=View NOVA, BioLogic, Gamry, Neware and Arbin measurements with selectable axes
Exec=/usr/bin/env @PYTHON@ @APP@ %F
Icon=office-chart-line
Terminal=false
Categories=Science;DataVisualization;
MimeType=application/x-metrohm-nova-nox;application/x-biologic-mpr;application/x-biologic-mpt;application/x-gamry-dta;application/x-neware-nda;application/x-neware-ndax;application/x-arbin-res;
Keywords=electrochemistry;NOVA;NOX;Autolab;BioLogic;EC-Lab;MPR;MPT;Gamry;Neware;Arbin;voltage;capacity;plot;
StartupNotify=false
